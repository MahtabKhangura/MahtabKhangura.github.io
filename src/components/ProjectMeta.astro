---
type ProjectLinks = {
  repo?: string;
  demo?: string;
  other?: { label: string; url: string };
};

interface Props {
  tags: string[];
  links?: ProjectLinks;
  date?: Date;
}

const { tags, links, date } = Astro.props;

const formattedDate =
  date &&
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
  });
---

{
  formattedDate && (
    <p class="project-header__meta">
      <time datetime={date?.toISOString()}>{formattedDate}</time>
    </p>
  )
}

{
  tags.length > 0 && (
    <ul class="tag-list" style="margin-bottom: 1rem;">
      {tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>
  )
}

{
  links && (links.repo || links.demo || links.other) && (
    <div class="link-row">
      {links.repo && (
        <a class="btn btn--primary" href={links.repo} target="_blank" rel="noreferrer">
          Repository
        </a>
      )}
      {links.demo && (
        <a class="btn" href={links.demo} target="_blank" rel="noreferrer">
          Live demo
        </a>
      )}
      {links.other && (
        <a class="btn" href={links.other.url} target="_blank" rel="noreferrer">
          {links.other.label}
        </a>
      )}
    </div>
  )
}
