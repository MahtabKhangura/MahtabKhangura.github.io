---
interface Props {
  href: string;
  title: string;
  summary: string;
  tags: string[];
  thumbnail?: string;
}

const { href, title, summary, tags, thumbnail } = Astro.props;
---

<a class="project-card" href={href}>
  {
    thumbnail && (
      <div class="project-card__media">
        <img src={thumbnail} alt="" loading="lazy" width="640" height="360" />
      </div>
    )
  }
  <div class="project-card__body">
    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__summary">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>
