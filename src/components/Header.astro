---
import { site } from '../lib/site';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/">{site.name}</a>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
